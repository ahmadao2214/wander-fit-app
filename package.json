{
  "name": "wander-fit-app",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "upgrade:tamagui": "bun update --latest tamagui @tamagui/colors @tamagui/config @tamagui/lucide-icons @tamagui/toast @tamagui/babel-plugin @tamagui/cli @tamagui/metro-plugin",
    "upgrade:tamagui:canary": "bun add tamagui@canary @tamagui/colors@canary @tamagui/config@canary @tamagui/lucide-icons@canary @tamagui/toast@canary && bun add -d @tamagui/babel-plugin@canary @tamagui/cli@canary @tamagui/metro-plugin@canary",
    "check:tamagui": "tamagui check",
    "start": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web --clear",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci",
    "typecheck": "tsc --noEmit",
    "verify:doctor": "node scripts/verify/run.mjs doctor",
    "verify:web": "node scripts/verify/run.mjs all",
    "sim:tunnel": "NODE_OPTIONS=\"--require ./scripts/sim/no-multipart.cjs\" expo start --tunnel",
    "sim:cloud-check": "bash scripts/sim/cloud-check.sh"
  },
  "overrides": {
    "esbuild": "0.25.4",
    "react-native-web": "0.21.4"
  },
  "dependencies": {
    "@clerk/clerk-expo": "^2.15.0",
    "@clerk/clerk-react": "^5.47.0",
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@lottiefiles/dotlottie-react": "^0.17.10",
    "@react-navigation/native": "^7.1.6",
    "@tamagui/colors": "^1.139.2",
    "@tamagui/config": "^1.139.2",
    "@tamagui/lucide-icons": "^1.139.2",
    "@tamagui/toast": "^1.139.2",
    "@testing-library/react-native": "^13.3.3",
    "burnt": "^0.12.2",
    "convex": "^1.27.0",
    "expo": "^58.0.25",
    "expo-auth-session": "~58.0.18",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.20",
    "expo-font": "~58.0.12",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "jest-expo": "~58.0.14",
    "lottie-react-native": "~7.5.0",
    "memoize-one": "^6.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "tamagui": "^1.139.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-dynamic-import": "^7.27.1",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/ngrok": "^4.1.3",
    "@tamagui/babel-plugin": "^1.139.2",
    "@tamagui/cli": "^1.139.2",
    "@tamagui/metro-plugin": "^1.139.2",
    "@types/jest": "30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "~19.3.0",
    "babel-jest": "^30.0.0",
    "convex-test": "0.0.41",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "packageManager": "bun@1.3.5",
  "patchedDependencies": {
    "react-native-draggable-flatlist@4.0.3": "patches/react-native-draggable-flatlist@4.0.3.patch"
  }
}
