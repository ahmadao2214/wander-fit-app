{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "es5",
  "ignorePatterns": [
    "convex/_generated/**",
    "docs/**",
    ".claude/**",
    "patches/**",
    "dist-verify/**",
    "dist-android/**",
    "android/**",
    "e2e-artifacts/**",
    "tsconfig.base.json",
    "assets/lottie/**"
  ]
}
